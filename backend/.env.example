# Application
APP_NAME=fitness-coach-agent
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitness_coach

# DashScope / LLM
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
COACH_ROUTER_MODEL=qwen3.5-flash
COACH_ANSWER_MODEL=qwen3.7-plus
COACH_PLANNER_MODEL=qwen3.7-plus
COACH_EMBEDDING_MODEL=text-embedding-v3
COACH_LONG_CONTEXT_MODEL=qwen-long
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Auth
AUTH_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Embeddings & RAG
EMBEDDING_DIM=1024
RAG_TOP_K=3
RAG_HYBRID_ENABLED=true
RAG_KEYWORD_TOP_K=12
RAG_VECTOR_CANDIDATE_K=20
RAG_VECTOR_SCORE_MIN=0.55
RAG_VECTOR_SCORE_MIN_WITH_KEYWORD=0.45
RAG_KEYWORD_TOP_FOR_FILTER=3
RAG_VECTOR_TOP_FOR_FILTER=10
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATE_K=15
RAG_MMR_ENABLED=true
RAG_MMR_LAMBDA=0.7
COACH_RERANK_MODEL=gte-rerank-v2
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_SCORE_THRESHOLD=0.35
USE_RAG_DEFAULT=true

# Graph RAG
GRAPH_RAG_ENABLED=true

# Agent
SUB_AGENT_MAX_TOOL_STEPS=4
MAX_SUB_AGENTS_PER_TURN=2
PARALLEL_SUB_AGENTS_ENABLED=true
COT_ENABLED=true
COT_SSE_ENABLED=false
AGENT_ENABLE_THINKING_STEPS=true
PROFILE_REQUIRED_FOR_PLAN=false

# Long context & LoRA
LONG_CONTEXT_MODE=summary
LORA_ENABLED=false
LORA_ADAPTER_PATH=

# Memory
MEMORY_MAX_TURNS=8
MEMORY_MAX_PROMPT_TOKENS=12000
MEMORY_SUMMARY_TRIGGER_TURNS=12
MEMORY_SUMMARY_MAX_CHARS=500
MEMORY_MAX_USER_CHARS=8000

# Ingest — changing chunk size/strategy requires reindexing existing documents
INGEST_CHUNK_SIZE=400
INGEST_CHUNK_OVERLAP=60
UPLOAD_DIR=backend/data/uploads
MAX_UPLOAD_BYTES=10485760

# Benchmark
BENCHMARK_CONCURRENCY=2
BENCHMARK_FAITHFULNESS_USE_LLM=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
